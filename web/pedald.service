# systemd unit for the active pedal daemon.
# Paths assume user simpedal, the repo at ~/projects/race-sim-active-pedal and a
# venv at <repo>/venv (uv venv --python 3.12 venv && uv pip install --python venv/bin/python pyserial).
# Other user/path: edit User, WorkingDirectory and ExecStart.
# Install:
#   sudo cp web/pedald.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now pedald
# Stop it before using tools/ (they need the serial port):  sudo systemctl stop pedald
[Unit]
Description=Active pedal daemon (serial owner + web GUI on :8080)
After=network.target pedal-gadget.service
Wants=pedal-gadget.service

[Service]
User=simpedal
WorkingDirectory=/home/simpedal/projects/race-sim-active-pedal/web
ExecStart=/home/simpedal/projects/race-sim-active-pedal/venv/bin/python -u pedald.py
# SIGTERM -> pedald disarms the pedal before exiting
KillSignal=SIGTERM
TimeoutStopSec=5
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
